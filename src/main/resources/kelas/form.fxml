<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Manajemen Produk" />
            <Button onAction="#bukaDaftar" text="Lihat Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label styleClass="subtitle" text="Tambah Produk Baru" />
                        
                        <Label text="Nama Produk" />
                        <TextField fx:id="namaField" promptText="Contoh: Kopi Susu" />
                        
                        <Label text="Kategori Produk" />
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity" />
                        
                        <Label text="Harga Produk" />
                        <TextField fx:id="hargaField" promptText="Contoh: 15000" />
                        
                        <Label text="Foto Produk (Opsional)" />
                        <ImageView fx:id="gambarView" fitHeight="160" fitWidth="280" preserveRatio="true" />
                        <Button onAction="#pilihGambar" text="Pilih Gambar" />
                        <Label styleClass="muted" text="PNG/JPEG. File lokal, bukan upload ke server." wrapText="true" />
                        
                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan dan Lihat Detail" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
